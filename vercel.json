    { "source": "/bab/", "destination": "/oferta02.html" },
    { "source": "/pas", "destination": "/oferta03.html" },
    { "source": "/pas/", "destination": "/oferta03.html" },
    { "source": "/oferta01", "destination": "/oferta01.html" },
    { "source": "/oferta01/", "destination": "/oferta01.html" },
    { "source": "/oferta02", "destination": "/oferta02.html" },
    { "source": "/oferta02/", "destination": "/oferta02.html" },
    { "source": "/oferta03", "destination": "/oferta03.html" },
    { "source": "/oferta03/", "destination": "/oferta03.html" }
  ]
